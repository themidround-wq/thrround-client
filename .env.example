# theround-service base URL, including /api
THEROUND_API_URL=http://localhost:3000/api

# Public origin of this app (used for the Google redirect URI). Defaults to the request origin.
APP_URL=http://localhost:5173

# Google OAuth web client: same client id as the service GOOGLE_CLIENT_ID.
# Add <APP_URL>/auth/google/callback as an authorised redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local demo with an in-memory mock backend (ignored in production builds).
# MOCK_MODE=1
